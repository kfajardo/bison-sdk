{
  "name": "@kfajardo/sdk",
  "version": "0.1.0",
  "description": "Bison JIB SDK: typed API client, onboarding validation rules, and unstyled onboarding web components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kfajardo/bison-sdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "typescript": "^5.5.0"
  }
}
